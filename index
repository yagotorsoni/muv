<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MUV — Brand Guidelines</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800;900&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  /* ─── MUV CORE PALETTE ─── */
  --muv-black:      #0D1117;
  --muv-surface:    #161B22;
  --muv-surface-2:  #1E2630;
  --muv-surface-3:  #252D38;
  --muv-orange:     #FF5F1F;
  --muv-orange-dim: rgba(255,95,31,0.12);
  --muv-orange-glow:rgba(255,95,31,0.35);
  --muv-white:      #F0EDEB;
  --muv-white-60:   rgba(240,237,235,0.6);
  --muv-white-30:   rgba(240,237,235,0.3);
  --muv-white-10:   rgba(240,237,235,0.08);
  --muv-gray:       #6B7280;
  --muv-border:     rgba(240,237,235,0.08);
}

html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', sans-serif;
  background: var(--muv-black);
  color: var(--muv-white);
  line-height: 1.5;
  overflow-x: hidden;
}

/* ═══ LAYOUT PRIMITIVES ═══════════════════════════ */
.page { padding: 80px 72px; position: relative; }
.page-wide { padding: 80px 0; position: relative; }
.divider { border: none; border-top: 1px solid var(--muv-border); }

.chip {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--muv-gray);
  margin-bottom: 48px;
}
.chip::before {
  content: '';
  display: inline-block;
  width: 28px;
  height: 1px;
  background: var(--muv-orange);
}

h2.section-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(44px, 6vw, 72px);
  letter-spacing: 0.02em;
  line-height: 1;
  margin-bottom: 20px;
}

p.section-body {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.75;
  color: var(--muv-white-60);
  max-width: 620px;
  margin-bottom: 64px;
}

/* ═══ 00 — COVER ══════════════════════════════════ */
.cover {
  min-height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  padding: 48px 72px;
  background: var(--muv-black);
  position: relative;
  overflow: hidden;
}

/* Orange glow top-right */
.cover::after {
  content: '';
  position: absolute;
  top: -20%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(255,95,31,0.12) 0%, transparent 65%);
  pointer-events: none;
}

.cover-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 10px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--muv-gray);
  position: relative;
  z-index: 2;
}

.cover-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px;
  letter-spacing: 0.2em;
  color: var(--muv-white);
}

.cover-logo span {
  color: var(--muv-orange);
}

.cover-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.cover-eyebrow {
  font-size: 11px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--muv-orange);
  margin-bottom: 24px;
}

.cover-wordmark {
  display: flex;
  flex-direction: column;
}

.cover-muv {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(100px, 18vw, 220px);
  line-height: 0.88;
  letter-spacing: 0.04em;
  color: var(--muv-white);
}

.cover-tagline {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.45em;
  text-transform: uppercase;
  color: var(--muv-orange);
  margin-top: 20px;
}

.cover-desc {
  margin-top: 56px;
  max-width: 480px;
  font-size: 15px;
  font-weight: 300;
  line-height: 1.75;
  color: var(--muv-white-60);
}

.cover-footer {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 32px;
  border-top: 1px solid var(--muv-border);
  padding-top: 32px;
  position: relative;
  z-index: 2;
}

.cover-footer-item {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.cover-footer-item span {
  display: block;
  color: var(--muv-gray);
  margin-bottom: 4px;
}

.cover-footer-item strong {
  color: var(--muv-white);
  font-weight: 500;
}

/* ═══ 01 — MANIFESTO ═════════════════════════════ */
.manifesto {
  background: var(--muv-surface);
  padding: 100px 72px;
}

.manifesto-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(28px, 4.5vw, 56px);
  line-height: 1.1;
  letter-spacing: 0.02em;
  max-width: 900px;
}

.manifesto-text .highlight {
  color: var(--muv-orange);
}

.manifesto-text .dim {
  color: var(--muv-white-30);
}

.manifesto-sub {
  margin-top: 48px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}

.manifesto-value {
  background: var(--muv-surface-2);
  padding: 32px 28px;
  border-top: 2px solid transparent;
  transition: border-color 0.3s;
}

.manifesto-value:hover {
  border-top-color: var(--muv-orange);
}

.manifesto-value-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--muv-white);
  margin-bottom: 12px;
}

.manifesto-value-text {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.7;
  color: var(--muv-white-60);
}

/* ═══ 02 — LOGO SYSTEM ═══════════════════════════ */
.logo-section { background: var(--muv-black); padding: 80px 72px; }

.logo-primary {
  background: var(--muv-surface);
  padding: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16px;
  position: relative;
  overflow: hidden;
  margin-bottom: 2px;
}

/* subtle grid overlay */
.logo-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--muv-white-10) 1px, transparent 1px),
    linear-gradient(90deg, var(--muv-white-10) 1px, transparent 1px);
  background-size: 60px 60px;
}

.logo-muv-display {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 120px;
  letter-spacing: 0.12em;
  line-height: 1;
  color: var(--muv-white);
  position: relative;
  z-index: 1;
}

.logo-tag-display {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.5em;
  text-transform: uppercase;
  color: var(--muv-orange);
  position: relative;
  z-index: 1;
}

.logo-variants {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  margin-bottom: 2px;
}

.logo-variant {
  padding: 48px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.lv-dark { background: var(--muv-surface); }
.lv-darker { background: #070A0E; }
.lv-white { background: var(--muv-white); }
.lv-orange { background: var(--muv-orange); }
.lv-mid { background: #2A3441; }

.lv-white .logo-muv-sm { color: var(--muv-black) !important; }
.lv-white .logo-tag-sm { color: rgba(10,10,10,0.5) !important; }
.lv-orange .logo-muv-sm { color: var(--muv-white) !important; }
.lv-orange .logo-tag-sm { color: rgba(240,237,235,0.7) !important; }

.logo-muv-sm {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 52px;
  letter-spacing: 0.12em;
  color: var(--muv-white);
  line-height: 1;
}

.logo-tag-sm {
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.45em;
  text-transform: uppercase;
  color: var(--muv-orange);
}

.logo-variant-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muv-gray);
  margin-top: 8px;
}

/* Logo don'ts */
.logo-rules {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  margin-top: 2px;
}

.logo-rule {
  background: var(--muv-surface);
  padding: 32px 24px;
}

.logo-rule-preview {
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  border: 1px solid var(--muv-border);
}

.logo-rule-bad {
  position: relative;
}
.logo-rule-bad::after {
  content: '';
  position: absolute;
  inset: 0;
  border: 2px solid rgba(255,60,60,0.5);
}

.logo-rule-label {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muv-gray);
  margin-bottom: 6px;
}

.logo-rule-desc {
  font-size: 12px;
  font-weight: 300;
  color: var(--muv-white-60);
  line-height: 1.5;
}

.dont-tag { color: rgba(255,80,80,0.8); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; }
.do-tag { color: rgba(80,220,130,0.8); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; }

/* Clearspace */
.clearspace-demo {
  background: var(--muv-surface);
  padding: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
  position: relative;
}

.clearspace-inner {
  border: 1px dashed rgba(255,95,31,0.3);
  padding: 32px 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.clearspace-arrow {
  position: absolute;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muv-orange);
}

/* ═══ 03 — COLOR SYSTEM ══════════════════════════ */
.color-section { background: var(--muv-black); padding: 80px 72px; }

.color-hero {
  height: 280px;
  display: flex;
  gap: 2px;
  margin-bottom: 2px;
  overflow: hidden;
}

.color-hero-swatch {
  flex: 1;
  position: relative;
  transition: flex 0.5s cubic-bezier(.25,1,.5,1);
  cursor: default;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24px 20px;
}

.color-hero-swatch:hover { flex: 3; }

.swatch-name {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.swatch-hex-val {
  font-family: 'Inter', monospace;
  font-size: 11px;
  opacity: 0.6;
  letter-spacing: 0.05em;
}

.swatch-role-val {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  opacity: 0.5;
  margin-top: 4px;
}

.c-black   { background: #0D1117; }
.c-surface { background: #161B22; }
.c-s2      { background: #1E2630; }
.c-orange  { background: #FF5F1F; }
.c-white   { background: #F0EDEB; }
.c-gray    { background: #6B7280; }

.dark-label  { color: var(--muv-white); }
.light-label { color: var(--muv-black); }

/* Color usage system */
.color-usage {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  margin-top: 2px;
}

.color-usage-card {
  background: var(--muv-surface);
  padding: 40px 36px;
}

.usage-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--muv-white);
  margin-bottom: 8px;
}

.usage-desc {
  font-size: 13px;
  font-weight: 300;
  color: var(--muv-white-60);
  line-height: 1.65;
  margin-bottom: 24px;
}

.usage-bar {
  height: 8px;
  border-radius: 99px;
  overflow: hidden;
  background: var(--muv-surface-3);
  display: flex;
  gap: 2px;
}

.usage-fill {
  height: 100%;
  border-radius: 99px;
}

/* Gradients */
.color-gradients {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  margin-top: 2px;
}

.gradient-card {
  height: 160px;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20px;
}

.gradient-card-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(240,237,235,0.7);
}

.gradient-card-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 24px;
  letter-spacing: 0.05em;
  color: var(--muv-white);
}

.g1 { background: radial-gradient(circle at 80% 20%, rgba(255,95,31,0.4) 0%, #0D1117 60%); }
.g2 { background: linear-gradient(135deg, #1E2630 0%, #FF5F1F 100%); }
.g3 { background: linear-gradient(180deg, #0D1117 0%, #161B22 50%, rgba(255,95,31,0.08) 100%); }

/* ═══ 04 — TYPOGRAPHY ════════════════════════════ */
.type-section { background: var(--muv-surface); padding: 80px 72px; }

.type-scale {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 2px;
  margin-top: 64px;
}

.type-row {
  display: contents;
}

.type-meta-col {
  background: var(--muv-surface-2);
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.type-meta-name {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muv-orange);
  margin-bottom: 4px;
}

.type-meta-spec {
  font-size: 11px;
  color: var(--muv-gray);
  line-height: 1.5;
}

.type-example-col {
  background: var(--muv-surface-2);
  padding: 32px 40px;
  display: flex;
  align-items: center;
}

.te-d1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 80px;
  letter-spacing: 0.06em;
  line-height: 1;
  color: var(--muv-white);
}

.te-d2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 48px;
  letter-spacing: 0.06em;
  line-height: 1;
  color: var(--muv-white);
}

.te-h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 32px;
  letter-spacing: 0.06em;
  color: var(--muv-white);
}

.te-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--muv-orange);
}

.te-body {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.75;
  color: var(--muv-white-60);
  max-width: 480px;
}

.te-small {
  font-size: 13px;
  font-weight: 400;
  line-height: 1.65;
  color: var(--muv-gray);
}

.te-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 64px;
  letter-spacing: 0.02em;
  line-height: 1;
  color: var(--muv-orange);
}

/* Type in context */
.type-in-context {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  margin-top: 2px;
}

.tic-card {
  background: var(--muv-surface-2);
  padding: 48px 40px;
}

/* ═══ 05 — ICONOGRAPHY & GRAPHIC ELEMENTS ════════ */
.icon-section { background: var(--muv-black); padding: 80px 72px; }

.graphic-elements {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  margin-top: 64px;
}

.ge-card {
  background: var(--muv-surface);
  padding: 48px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

.ge-visual {
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ge-label {
  font-size: 10px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--muv-gray);
  text-align: center;
}

/* SVG Icons */
.icon-diamond {
  width: 40px;
  height: 40px;
  background: var(--muv-white-10);
  transform: rotate(45deg);
  border: 1px solid var(--muv-white-30);
  position: relative;
}

.icon-diamond::after {
  content: '';
  position: absolute;
  inset: 6px;
  background: transparent;
  border: 1px solid rgba(240,237,235,0.15);
}

.icon-arrow {
  width: 48px;
  height: 2px;
  background: var(--muv-orange);
  position: relative;
}

.icon-arrow::after {
  content: '';
  position: absolute;
  right: -1px;
  top: -5px;
  width: 12px;
  height: 12px;
  border-top: 2px solid var(--muv-orange);
  border-right: 2px solid var(--muv-orange);
  transform: rotate(45deg);
}

.icon-slash {
  width: 2px;
  height: 48px;
  background: var(--muv-white-30);
  transform: rotate(25deg);
}

.icon-dot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--muv-white-30);
}

.dot.accent { background: var(--muv-orange); }

/* ═══ 06 — BRAND VOICE ═══════════════════════════ */
.voice-section { background: var(--muv-surface); padding: 80px 72px; }

.voice-spectrum {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  margin-top: 64px;
  margin-bottom: 2px;
}

.vs-card {
  background: var(--muv-surface-2);
  padding: 36px 28px;
}

.vs-axis {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.vs-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--muv-orange);
  flex-shrink: 0;
}

.vs-title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muv-white);
}

.vs-not {
  font-size: 11px;
  font-weight: 400;
  color: var(--muv-gray);
  letter-spacing: 0.05em;
  text-transform: none;
  margin-top: 2px;
}

.vs-desc {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.65;
  color: var(--muv-white-60);
}

/* Copy examples */
.copy-examples {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}

.copy-card {
  background: var(--muv-surface-2);
  padding: 40px 36px;
}

.copy-card-header {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  padding: 6px 12px;
  display: inline-block;
  margin-bottom: 28px;
  border-radius: 2px;
}

.copy-do .copy-card-header {
  background: rgba(80,220,130,0.1);
  color: rgba(80,220,130,0.9);
}

.copy-dont .copy-card-header {
  background: rgba(255,80,80,0.1);
  color: rgba(255,80,80,0.9);
}

.copy-line {
  padding: 16px 0;
  border-bottom: 1px solid var(--muv-border);
  font-size: 14px;
  font-weight: 300;
  color: var(--muv-white-60);
  line-height: 1.5;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.copy-line::before {
  content: '—';
  color: var(--muv-gray);
  flex-shrink: 0;
}

.copy-do .copy-line { color: var(--muv-white-60); }
.copy-dont .copy-line { color: rgba(240,237,235,0.35); text-decoration: line-through; text-decoration-color: rgba(255,80,80,0.4); }

/* ═══ 07 — PHOTOGRAPHY DIRECTION ════════════════ */
.photo-section { background: var(--muv-black); padding: 80px 72px; }

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: 280px 280px;
  gap: 2px;
  margin-top: 64px;
}

.photo-card {
  background: var(--muv-surface);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px 24px;
}

.photo-card-span2 {
  grid-column: span 2;
}

.photo-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(13,17,23,0.9) 0%, transparent 55%);
  z-index: 1;
}

.photo-art {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

